# Copie para .env no SERVIDOR e preencha. O arquivo .env NUNCA vai para o Git.

# Prefixo das imagens no GitHub Container Registry (tudo minúsculo): ghcr.io/SEU_USUARIO/NOME_DO_REPOSITORIO
IMAGE_PREFIX=ghcr.io/usuario/dashboard
TAG=latest

# Banco
POSTGRES_PASSWORD=

# Painel (login do navegador). Deixe DASH_PASSWORD vazio só se confiar no acesso pela rede Tailscale.
DASH_USER=admin
DASH_PASSWORD=

# Token secreto que vai na URL dos webhooks (gere com: openssl rand -hex 24)
WEBHOOK_TOKEN=

# Pluggy (https://dashboard.pluggy.ai). ITEM_IDS: um ou mais itemId separados por vírgula (Nubank, Sicredi).
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_IDS=
PLUGGY_SYNC_MINUTES=15
PLUGGY_INITIAL_DAYS=90

# Importa o extrato inicial (do arquivo enviado) na primeira subida. Depois de importar não faz mais nada.
SEED_INITIAL=true

# Alertas por WhatsApp (opcional). Se WHATSAPP_ENABLED=true, o setup.sh também sobe o Evolution API
# (gateway não-oficial via QR code) junto com o resto. Veja o README para o passo a passo de conectar o número.
WHATSAPP_ENABLED=false
WHATSAPP_NUMBERS=                 # números em formato internacional, sem símbolos, separados por vírgula (ex: 5544999998888)
WHATSAPP_ALERT_HOUR=8             # hora do resumo diário (fuso de TZ_NAME, padrão America/Sao_Paulo)
WHATSAPP_DUE_SOON_DAYS=2          # avisa boleto/fatura que vence em até N dias
EVOLUTION_API_KEY=                # gere com: openssl rand -hex 24 — também autentica as chamadas do backend ao Evolution API
EVOLUTION_DB_PASSWORD=            # senha só do banco interno do Evolution API — gere com: openssl rand -hex 24
EVOLUTION_API_URL=http://evolution-api:8080   # endereço interno do Docker — não precisa mudar
EVOLUTION_INSTANCE=dashboard                  # nome da "instância" (sessão) do WhatsApp dentro do Evolution API
